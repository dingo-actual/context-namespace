"""Type stubs for the private _native PyO3 extension module.

This module provides type annotations for the native extension module
generated by PyO3. These stubs are for static type checkers only and are
ignored at runtime.

Important Classes:
    _NativeNamespace: Internal PyO3 wrapper around the Rust
        ContextNamespace.
    _PyAppendReceipt: Native receipt for append operations.
    _PyRenderedHistory: Native render result.
    _PySummaryReceipt: Native receipt for summary commits.
    _PyExpansionReceipt: Native receipt for expand/collapse operations.
    _PyPreparedSummary: Native prepared summary transaction token.
    _PyRenderPreview: Native non-mutating render preview.
    _PyMaintenanceUnit: Per-record maintenance unit.
    _PyNodeDescriptor: Native node descriptor.
    _PyStructuralStats: Native structural statistics.
    _PyCapabilities: Native capability report.
    _PyChildDescriptor: Native child node descriptor.

Important Variables:
    __all__: List of all exported names from the native module.
"""

from collections.abc import Mapping, Sequence
from typing import final

class ContextNamespaceError(Exception):
    """Base exception for all context-namespace native errors."""

class InvalidRecordError(ContextNamespaceError):
    """A record is invalid (missing render field, wrong type)."""

class ReservedKeyCollisionError(InvalidRecordError):
    """A record contains the reserved metadata key."""

class InvalidSelectionError(ContextNamespaceError):
    """A selection range is invalid."""

class StaleRenderError(InvalidSelectionError):
    """The render ID is stale or unknown."""

class UnknownPathError(ContextNamespaceError):
    """The path or node ID does not resolve to a live node."""

class PathCollisionError(ContextNamespaceError):
    """A new node path collides with an existing path or alias."""

class PolicyViolationError(ContextNamespaceError):
    """The policy configuration rejects the operation."""

class StaleSummaryError(ContextNamespaceError):
    """The summary request is stale or not found."""

class InvalidSummaryError(ContextNamespaceError):
    """The summary result fails validation."""

class EmbeddingMismatchError(ContextNamespaceError):
    """Embedding dimensions or model ID do not match."""

class SnapshotVersionError(ContextNamespaceError):
    """The snapshot schema version is unsupported."""

class InvariantViolationError(ContextNamespaceError):
    """An invariant violation was detected during validation."""

@final
class _PyAppendReceipt:
    """Native receipt for a successful append operation.

    Attributes:
        record_id: The stable ID assigned to the inserted record.
        visible_index: The zero-based visible index of the record.
    """

    record_id: str
    visible_index: int

@final
class _PyRenderedHistory:
    """Native result of a successful render operation.

    Attributes:
        render_id: The unique ID for this render.
        namespace_version: The namespace version at render time.
        json: The rendered JSON string.
        bytes: The byte count of ``json``.
        entries: The number of visible entries in the rendered output.
    """

    render_id: str
    namespace_version: int
    json: str
    bytes: int
    entries: int

@final
class _PySummaryReceipt:
    """Native receipt for a successful summary commit.

    Attributes:
        node_id: The ID of the newly created summary node.
        carrier_record_id: The ID of the carrier or edited record.
        replaced_record_ids: IDs of the canonical records replaced.
        render_id: The render ID associated with the commit.
    """

    node_id: str
    carrier_record_id: str
    replaced_record_ids: list[str]
    render_id: str

@final
class _PyExpansionReceipt:
    """Native receipt for a successful expand or collapse operation.

    Attributes:
        node_id: The ID of the expanded or collapsed node.
        ttl_renders: The effective TTL in renders after the operation.
        render_id: The render ID associated with the activation.
    """

    node_id: str
    ttl_renders: int
    render_id: str

@final
class _PyMaintenanceUnit:
    """Native per-record maintenance unit for token estimation.

    Attributes:
        record_id: The stable record ID.
        render_digest: SHA-256 digest of the rendered JSON fragment.
        json_fragment: The rendered JSON fragment for this record.
    """

    record_id: str
    render_digest: str
    json_fragment: str

@final
class _PyRenderPreview:
    """Native non-mutating render preview with maintenance metadata.

    Unlike _PyRenderedHistory, a preview does not allocate a render_id,
    register visible-index resolutions, emit a render event, or decrement
    expansion TTLs.

    Attributes:
        namespace_version: The namespace version at preview time.
        json: The rendered JSON string.
        bytes: The byte count of ``json``.
        entries: The number of visible entries.
        maintenance_units: Per-record maintenance units for token
            estimation.
    """

    namespace_version: int
    json: str
    bytes: int
    entries: int
    maintenance_units: list[_PyMaintenanceUnit]

@final
class _PyPreparedSummary:
    """Native prepared summary transaction token.

    This object carries an opaque, hash-bound transaction token. It is
    consumed by _commit_summary or _cancel and cannot be reused.

    Attributes:
        request_id: The request ID associated with this summary.
        source: The rendered source text extracted from canonical state.
        max_summary_chars: Policy-enforced max character length for the
            summary.
        max_gloss_chars: Policy-enforced max character length for the gloss.
    """

    request_id: str
    source: str
    max_summary_chars: int
    max_gloss_chars: int

@final
class _PyNodeDescriptor:
    """Native descriptor for a summary node.

    Attributes:
        node_id: The immutable node ID.
        path: The current absolute path of the node.
        label: The node's label.
        parent_id: The parent node ID, or None for a root.
        child_count: The number of immediate children.
        summary_length: The character length of the summary text.
        summary: The summary text.
        gloss: The gloss text.
        expanded: Whether the node is currently expanded.
        source_kind: Either ``"TextSlice"`` or ``"RecordRange"``.
    """

    node_id: str
    path: str
    label: str
    parent_id: str | None
    child_count: int
    summary_length: int
    summary: str
    gloss: str
    expanded: bool
    source_kind: str

@final
class _PyStructuralStats:
    """Native snapshot of structural counts at a point in time.

    Attributes:
        records: Number of canonical records.
        nodes: Number of summary nodes.
        active_expansions: Number of active expansions (TTL > 0).
        pending_requests: Number of pending summary requests.
        alias_count: Number of retained path aliases.
        max_depth: Maximum tree depth (0 = no nodes).
        dropped_events: Events dropped due to queue overflow.
    """

    records: int
    nodes: int
    active_expansions: int
    pending_requests: int
    alias_count: int
    max_depth: int
    dropped_events: int

@final
class _PyCapabilities:
    """Native capability report with version and feature information.

    Attributes:
        library_version: The crate version from Cargo.toml.
        rust_api_version: The high-level Rust API version.
        snapshot_schema: Snapshot schema version.
        render_schema: Render schema version.
        policy_schema: Policy schema version.
        features: Enabled cargo feature names.
    """

    library_version: str
    rust_api_version: str
    snapshot_schema: int
    render_schema: int
    policy_schema: int
    features: list[str]

@final
class _PyChildDescriptor:
    """Native descriptor for an immediate child node of a summary.

    Attributes:
        node_id: The immutable ID of the child node.
        label: The child node's label.
        gloss: The child node's gloss text.
    """

    node_id: str
    label: str
    gloss: str

@final
class _NativeNamespace:
    """Internal PyO3 wrapper around the Rust ContextNamespace.

    This class exposes deliberately awkward private method names. Callers
    should use the public ContextNamespace facade instead.
    """

    def __new__(
        cls,
        config: Mapping[str, object],
        records: Sequence[Mapping[str, object]] | None,
    ) -> _NativeNamespace:
        """Constructs a native namespace from a config and optional records."""
        ...

    def append(self, record: Mapping[str, object]) -> _PyAppendReceipt:
        """Appends a record to the canonical sequence."""
        ...

    def render(self) -> _PyRenderedHistory:
        """Renders the current namespace state as deterministic JSON."""
        ...

    def _preview_render(self) -> _PyRenderPreview:
        """Produces a non-mutating render preview with maintenance metadata."""
        ...

    def _prepare_records(
        self, render_id: str, start: int, end: int, label: str
    ) -> _PyPreparedSummary:
        """Prepares a record-range summary transaction."""
        ...

    def _prepare_text(
        self,
        render_id: str,
        index: int,
        start_char: int,
        end_char: int,
        label: str,
    ) -> _PyPreparedSummary:
        """Prepares a text-slice summary transaction."""
        ...

    def _commit_summary(
        self, prepared: _PyPreparedSummary, summary: str, gloss: str
    ) -> _PySummaryReceipt:
        """Commits a prepared summary with the given result text."""
        ...

    def _cancel(self, prepared: _PyPreparedSummary) -> None:
        """Cancels a pending prepared summary without mutating state."""
        ...

    def _plan_maintenance(self, input: object) -> _PyPreparedSummary | None:
        """Plans automatic maintenance from harness-supplied token estimates.

        The Rust binding extracts ``estimated_next_tokens`` and ``records``
        via attribute access on the passed object, so any object with
        those attributes is accepted at runtime.
        """
        ...

    def expand(self, path: str, ttl: int) -> _PyExpansionReceipt:
        """Expands a summary node for the next ``ttl`` renders."""
        ...

    def collapse(self, path: str) -> _PyExpansionReceipt:
        """Collapses a summary node immediately."""
        ...

    def is_expanded(self, path: str) -> bool:
        """Checks whether a node at the given path is currently expanded."""
        ...

    def list_nodes(self) -> list[_PyNodeDescriptor]:
        """Returns descriptors for all nodes in the tree."""
        ...

    def stats(self) -> _PyStructuralStats:
        """Returns structural statistics for the namespace."""
        ...

    def capabilities(self) -> _PyCapabilities:
        """Returns enabled features and schema versions."""
        ...

    def validate(self) -> None:
        """Validates all namespace invariants."""
        ...

    def snapshot(self) -> bytes:
        """Serializes the namespace to versioned JSON with a content hash."""
        ...

    @staticmethod
    def restore(data: bytes) -> _NativeNamespace:
        """Rebuilds a native namespace from snapshot bytes."""
        ...

    def version(self) -> int:
        """Returns the current namespace version."""
        ...

    def drain_events(self, limit: int) -> list[str]:
        """Drains up to ``limit`` events from the internal event queue."""
        ...

__all__ = [
    "ContextNamespaceError",
    "EmbeddingMismatchError",
    "InvalidRecordError",
    "InvalidSelectionError",
    "InvalidSummaryError",
    "InvariantViolationError",
    "PathCollisionError",
    "PolicyViolationError",
    "ReservedKeyCollisionError",
    "SnapshotVersionError",
    "StaleRenderError",
    "StaleSummaryError",
    "UnknownPathError",
    "_NativeNamespace",
    "_PyAppendReceipt",
    "_PyCapabilities",
    "_PyChildDescriptor",
    "_PyExpansionReceipt",
    "_PyMaintenanceUnit",
    "_PyNodeDescriptor",
    "_PyPreparedSummary",
    "_PyRenderPreview",
    "_PyRenderedHistory",
    "_PyStructuralStats",
    "_PySummaryReceipt",
]
